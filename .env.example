# ==============================================================================
# DESTEK TALEP SİSTEMİ - CANLI ORTAM YAPILANDIRMASI (.env.example)
# Bu dosyayı canlı sunucuda veya yerel ortamda '.env' olarak kopyalayıp değerleri doldurunuz.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TEMEL DJANGO GÜVENLİK AYARLARI
# ------------------------------------------------------------------------------
# Canlıda güçlü, rastgele bir SECRET_KEY belirleyin:
SECRET_KEY=django-insecure-canli-ortam-icin-guclu-gizli-anahtar-buraya-yazilacak

# Canlıda DEBUG mutlaka False olmalıdır!
DEBUG=False

# Sunucunuzun domain veya IP adresleri (virgülle ayırarak):
ALLOWED_HOSTS=destek.sirketiniz.com,www.destek.sirketiniz.com,127.0.0.1


# ------------------------------------------------------------------------------
# 2. CANLI ORTAM CSRF, SSL VE OTURUM (SESSION) GÜVENLİĞİ
# ------------------------------------------------------------------------------
# Django 4+ ve Django 6+ gereği, HTTPS üzerinden gelen POST isteklerinin 403 CSRF
# engeline takılmaması için alan adlarınızı 'https://' protokolüyle virgülle ayırarak giriniz:
CSRF_TRUSTED_ORIGINS=https://destek.sirketiniz.com,https://www.destek.sirketiniz.com

# Sunucuda doğrudan SSL sertifikası sonlandırılıyorsa HTTP'yi HTTPS'e zorlamak için True yapın:
# (Not: Cloudflare, Nginx veya ters vekil (reverse proxy) SSL yönlendirmesi yapıyorsa False bırakabilirsiniz)
SECURE_SSL_REDIRECT=False

# Oturum çerezi geçerlilik süresi (Saniye cinsinden; Varsayılan: 28800 = 8 Saat):
SESSION_COOKIE_AGE=28800

# Tarayıcı tamamen kapatıldığında oturumu otomatik sonlandırma (Varsayılan: True):
SESSION_EXPIRE_AT_BROWSER_CLOSE=True


# ------------------------------------------------------------------------------
# 3. VERİTABANI (POSTGRESQL / SQLITE) YAPILANDIRMASI
# ------------------------------------------------------------------------------
# DATABASE_URL girildiğinde sistem otomatik olarak PostgreSQL moduna geçer.
# Tanımlanmadığı takdirde yerel geliştirme için SQLite (db.sqlite3) kullanılır.
#
# Format: postgres://<kullanici>:<sifre>@<sunucu_adresi>:<port>/<veritabani_adi>
DATABASE_URL=postgres://destek_user:GizliParola123@localhost:5432/destek_db

# Alternatif Bulut Sağlayıcı Örnekleri:
# Supabase: postgres://postgres.xxxx:sifre@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Neon: postgres://user:sifre@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Render / Railway: postgresql://postgres:sifre@roundhouse.proxy.rlwy.net:12345/railway


# ------------------------------------------------------------------------------
# 4. GERÇEK E-POSTA SERVİSİ (SMTP) YAPILANDIRMASI
# ------------------------------------------------------------------------------
# EMAIL_HOST tanımlandığında gerçek SMTP e-posta servisi aktifleşir.
# Tanımlanmazsa mailler konsola yazdırılır (django.core.mail.backends.console.EmailBackend).
# İsteğe bağlı özel backend (Örn: konsol veya smtp):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# ÖRNEK A: Gmail SMTP (Önerilen Basit Kurulum)
# Not: Gmail hesabınızda 2 Adımlı Doğrulama açıp 'Uygulama Şifresi' (16 haneli) üretmelisiniz.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=destek.sirketiniz@gmail.com
# EMAIL_HOST_PASSWORD=xxxx yyyy zzzz tttt
# DEFAULT_FROM_EMAIL=Destek Sistemi <destek.sirketiniz@gmail.com>

# ÖRNEK B: SendGrid / Mailgun / AWS SES (Kurumsal Toplu Mail)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=Destek Ekibi <destek@sirketiniz.com>

# ÖRNEK C: Kurumsal Yandex Mail / Office 365 / cPanel Webmail
# EMAIL_HOST=smtp.yandex.com
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=destek@sirketiniz.com
# EMAIL_HOST_PASSWORD=KurumsalSifre123
# DEFAULT_FROM_EMAIL=destek@sirketiniz.com


# ------------------------------------------------------------------------------
# 5. EKİP SOHBETİ (WEBSOCKET) VE ÖNBELLEK (REDIS) KATMANI
# ------------------------------------------------------------------------------
# REDIS_URL tanımlandığında hem Django Channels (WebSocket kümesi) hem de
# Django Cache (hız sınırları ve oturum kilitlemeleri) otomatik olarak Redis'e bağlanır.
# Çoklu worker (Gunicorn / Daphne) çalışan üretim ortamlarında önerilir:
# REDIS_URL=redis://127.0.0.1:6379/0


# ------------------------------------------------------------------------------
# 6. HARİCİ WEBHOOK VE AI ENTEGRASYONU (İsteğe Bağlı)
# ------------------------------------------------------------------------------
# Acil talep bildirimleri için Slack / Discord Webhook URL:
# OUTGOING_WEBHOOK_URL=https://discord.com/api/webhooks/...

# AI Copilot için OpenAI veya LLM API Anahtarı (Boşsa yerel kural motoru çalışır):
# AI_COPILOT_API_KEY=sk-...


# ------------------------------------------------------------------------------
# 7. E-POSTA İLE TALEP CEVAPLAMA WEBHOOK GÜVENLİK ANAHTARI
# ------------------------------------------------------------------------------
# Gelen e-posta ile bilet cevaplama webhook güvenliği için gizli token:
# INBOUND_EMAIL_WEBHOOK_SECRET=GucluWebhookSecretAnahtari123
